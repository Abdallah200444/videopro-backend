# Video Pro - Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── CORS - Frontend URL (Netlify URL after deploy) ───────────────────────────
# Add your Netlify URL here. During development use localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-site.netlify.app

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=500
TEMP_DIR=./tmp
RATE_LIMIT_MAX=30

# ─── Optional: Cobalt API ─────────────────────────────────────────────────────
# Leave blank to use default public instances
COBALT_API_URL=
